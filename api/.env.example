# Прод-окружение api (dev-значения захардкожены в docker-compose.yml)
SECRET_KEY=change-me
DEBUG=0
ALLOWED_HOSTS=api.manshoo.ru,127.0.0.1,localhost,api
CSRF_TRUSTED_ORIGINS=https://manshoo.ru,https://api.manshoo.ru
CORS_ALLOWED_ORIGINS=https://manshoo.ru
# Общая для поддоменов кука: нужна SSR-предпросмотру черновиков
SESSION_COOKIE_DOMAIN=.manshoo.ru
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=manshoo
POSTGRES_USER=manshoo
POSTGRES_PASSWORD=change-me
