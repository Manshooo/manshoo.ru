# Telegram-алерты (без этих переменных алерты идут в лог)
TELEGRAM_BOT_TOKEN=
# Для канала chat_id отрицательный, обычно с префиксом -100 (например, -1003930018902)
TELEGRAM_CHAT_ID=

# Если api.telegram.org заблокирован с хостинга — адрес своего прокси
# (например, Cloudflare Worker из deploy/telegram-proxy-worker.js)
# TELEGRAM_API_BASE=https://tg-proxy.example.workers.dev

# Внешний dead-man's-switch (healthchecks.io и т.п.): чекер пингует его
# каждые 5 минут, и если VPS целиком упадёт — тревогу поднимет он.
# Ссылка секретная: кто её знает, тот может заглушить тревогу.
# HEARTBEAT_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Адрес HTTP-сервера (по умолчанию :8080)
# UPTIME_ADDR=:8080
